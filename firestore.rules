rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@cafemoliere[.]com');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'administrator@cafemoliere.com';
    }

    // Customers place orders without signing in, so anonymous "create" is
    // allowed but every field is validated. Reading/managing orders is
    // staff-only — this is what keeps customer names/phones/addresses private.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','phone','address','items','total','status','time','date','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('[0-9]{7,15}')
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 300
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'new'
        && request.resource.data.time is string
        && request.resource.data.time.matches('[0-9]{1,2}:[0-9]{2}( ?[AP]M)?')
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{1,2}/[0-9]{1,2}/[0-9]{2,4}');
      allow read, update, delete: if isStaff();
    }

    // Public menu data, editable by staff (admin.html).
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // categories / appearance / special — public read, staff write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Live homepage content — public read, administrator-only write
    // (matches the check in admin-home.html).
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Draft homepage content — administrator only. The ?draft=1 preview on
    // index.html only works while signed in as the administrator.
    match /homepage-draft/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
